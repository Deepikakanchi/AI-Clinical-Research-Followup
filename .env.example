
# --- Required ---
DATABASE_URL=postgresql+psycopg://postgres:Password@localhost:5432/clinical_followup
# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Auth ---
JWT_EXPIRE_MINUTES=480

# --- Web ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Business rules ---
DUE_WINDOW_DAYS=7

# --- AI ---
AI_ENABLED=true
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# --- Tests only ---
TEST_DATABASE_URL=postgresql+psycopg://clinical:CHANGE_ME@localhost:5432/clinical_followup_test